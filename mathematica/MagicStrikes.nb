Cell[CellGroupData[{

Cell["Finite difference derivatives", "Subsection",
 CellChangeTimes->{{3.9824049493608828`*^9, 
  3.982404966828836*^9}},ExpressionUUID->"95068768-da53-45b1-9bac-\
03f6db09ff0b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"k0", "=", 
   RowBox[{"-", 
    FractionBox["M", "2"]}]}], ";", 
  RowBox[{"\[CapitalDelta]k", "=", 
   SqrtBox["M"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"S", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{"\[CapitalSigma]", "[", 
    RowBox[{"k0", " ", "+", " ", 
     RowBox[{"j", " ", "\[CapitalDelta]k"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d0", "=", 
   RowBox[{"S", "[", "0", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d1", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", " ", "\[CapitalDelta]k"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"S", "[", "1", "]"}], "-", 
      RowBox[{"S", "[", 
       RowBox[{"-", "1"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d2", " ", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", " ", 
      SuperscriptBox["\[CapitalDelta]k", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"S", "[", "1", "]"}], "+", 
      RowBox[{"S", "[", 
       RowBox[{"-", "1"}], "]"}], "-", 
      RowBox[{"2", 
       RowBox[{"S", "[", "0", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"d2", " ", "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[CapitalDelta]k", "2"]}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"S", "[", "1", "]"}], "+", 
       RowBox[{"S", "[", 
        RowBox[{"-", "1"}], "]"}], "-", 
       RowBox[{"2", 
        RowBox[{"S", "[", "0", "]"}]}]}], ")"}]}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"d3", "=", 
   RowBox[{
    FractionBox[
     RowBox[{" ", "1"}], 
     RowBox[{"12", " ", 
      SuperscriptBox["\[CapitalDelta]k", "3"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"S", "[", "2", "]"}], "-", 
      RowBox[{"2", " ", 
       RowBox[{"S", "[", "1", "]"}]}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"S", "[", 
        RowBox[{"-", "1"}], "]"}]}], "-", 
      RowBox[{"S", "[", 
       RowBox[{"-", "2"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d4", "=", " ", 
   RowBox[{
    FractionBox[
     RowBox[{" ", "1"}], 
     RowBox[{"12", " ", 
      SuperscriptBox["\[CapitalDelta]k", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"S", "[", "2", "]"}], "-", 
      RowBox[{"4", " ", 
       RowBox[{"S", "[", "1", "]"}]}], "-", 
      RowBox[{"4", " ", 
       RowBox[{"S", "[", 
        RowBox[{"-", "1"}], "]"}]}], "+", 
      RowBox[{"S", "[", 
       RowBox[{"-", "2"}], "]"}], "+", 
      RowBox[{"6", " ", 
       RowBox[{"S", "[", "0", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d5", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"1", " "}], 
     RowBox[{"240", " ", 
      SuperscriptBox["\[CapitalDelta]k", "5"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"S", "[", "3", "]"}], "-", 
      RowBox[{"4", " ", 
       RowBox[{"S", "[", "2", "]"}]}], "+", 
      RowBox[{"5", " ", 
       RowBox[{"S", "[", "1", "]"}]}], "-", 
      RowBox[{"5", " ", 
       RowBox[{"S", "[", 
        RowBox[{"-", "1"}], "]"}]}], "+", 
      RowBox[{"4", " ", 
       RowBox[{"S", "[", 
        RowBox[{"-", "2"}], "]"}]}], "-", 
      RowBox[{"S", "[", 
       RowBox[{"-", "3"}], "]"}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.97992553800638*^9, 3.979925566713675*^9}, 
   3.9799265746758623`*^9, {3.982409520509491*^9, 3.9824095258594437`*^9}, 
