       RowBox[{"S", "[", "1", "]"}], "+", 
       RowBox[{"S", "[", 
        RowBox[{"-", "1"}], "]"}], "-", 
       RowBox[{"2", 
        RowBox[{"S", "[", "0", "]"}]}]}], ")"}]}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"d3", "=", 
