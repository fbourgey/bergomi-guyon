        SuperscriptBox["M", "2"], " ", 
        SuperscriptBox["MXd", "2"], " ", "MXdXd"}], "+", 
       RowBox[{"64", " ", 
        SuperscriptBox["M", "2"], " ", 
        SuperscriptBox["MXdXd", "2"]}], "-", 
