Cell[BoxData[{
 RowBox[{
  RowBox[{"k0", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"p", "-", 
      FractionBox["1", "2"]}], ")"}], 
    RowBox[{"W", "[", "p", "]"}]}]}], ";", 
  RowBox[{"\[CapitalDelta]k", "=", 
   SqrtBox[
    RowBox[{"W", "[", "p", "]"}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"S", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{"\[CapitalSigma]", "[", 
    RowBox[{"k0", " ", "+", " ", 
     RowBox[{"j", " ", "\[CapitalDelta]k"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d0", "=", 
   RowBox[{"S", "[", "0", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d1", "=", 
