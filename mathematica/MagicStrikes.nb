Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"4", " ", 
       SuperscriptBox["k", "2"], " ", "M"}], "-", 
      RowBox[{"4", " ", 
