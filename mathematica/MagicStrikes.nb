Cell[TextData[{
 "There are  no single trees, only products of two trees and three trees .  \
Indeed, we can see stochasticity  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"MXdXd", "+", 
     FractionBox["1", "4"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b757c2d9-581d-4a9c-a60f-1dbd1643860f"],
 "MMd) appear.\nWe start with the r=2 term.  Subtracting M d2 d1 does it!"
}], "Text",
 CellChangeTimes->{{3.999004652386282*^9, 3.999004781294804*^9}, {
   3.999004855617476*^9, 3.999004871902424*^9}, {3.9990049870110273`*^9, 
