Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]", "[", "p_", "]"}], "=", 
   RowBox[{
    FractionBox["1", "2"], "p", 
    RowBox[{"(", 
     RowBox[{"p", "-", "1"}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9942626318936768`*^9, 3.9942626639951878`*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"494fef68-b11a-4b45-834c-37c7a2d04391"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"W", "[", "p_", "]"}], "=", 
   RowBox[{"M", "+", 
    RowBox[{"p", " ", "MXd", " ", "\[Epsilon]"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["p", "2"], "MXdXd"}], " ", "+", " ", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"\[Lambda]", "[", "p", "]"}], "MMd"}]}], ")"}], 
     SuperscriptBox["\[Epsilon]", "2"]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["p", "3"], "MXdXdXd"}], "+", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"\[Lambda]", "[", "p", "]"}], "p", " ", "MMdXd"}], "+", 
       RowBox[{
        RowBox[{"\[Lambda]", "[", "p", "]"}], "p", " ", "MXdMd"}]}], " ", 
      ")"}], 
     SuperscriptBox["\[Epsilon]", "3"]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["p", "4"], "MXdXdXdXd"}], "+", 
       RowBox[{
        SuperscriptBox["p", "2"], 
        RowBox[{"\[Lambda]", "[", "p", "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], "MMdXdXd"}], "+", "MXdMdXd", "+", "MXdXdMd",
           "+", 
          RowBox[{
           FractionBox["1", "2"], "MXdMXdd"}]}], ")"}]}], "+", 
       RowBox[{
        FractionBox["1", "2"], 
        SuperscriptBox[
         RowBox[{"\[Lambda]", "[", "p", "]"}], "2"], "MMdMd"}]}], ")"}], " ", 
     
     SuperscriptBox["\[Epsilon]", "4"]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["p", 
         RowBox[{"5", " "}]], "MXdXdXdXdXd"}], "+", 
       RowBox[{
        SuperscriptBox["p", "3"], 
        RowBox[{"\[Lambda]", "[", "p", "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], "MMdXdXdXd"}], "+", "MXdMdXdXd", "+", 
          "MXdXdMdXd", "+", 
          RowBox[{
           FractionBox["1", "2"], "MXdMXddXd"}], "+", "MXdXdXdMd", "+", 
          "MXdXdMXdd"}], ")"}]}], "+", 
       RowBox[{"p", " ", 
        SuperscriptBox[
         RowBox[{"\[Lambda]", "[", "p", "]"}], "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], "MMdXdMd"}], "+", 
          RowBox[{
           FractionBox["1", "2"], "MMdMdXd"}], "+", "MXdMdMd", "+", 
          RowBox[{
           FractionBox["1", "2"], "MMdMXdd"}]}], ")"}]}]}], ")"}], " ", 
     SuperscriptBox["\[Epsilon]", "5"]}]}]}], ";"}]], "Input",
