  3.9985681819410467`*^9}},ExpressionUUID->"39101978-1988-403b-a5ee-\
b2144d938a34"],

Cell[BoxData[
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"M", "+", 
    RowBox[{"MXd", " ", "\[Epsilon]"}], "+", 
    RowBox[{"MXdXd", " ", 
     SuperscriptBox["\[Epsilon]", "2"]}], "+", 
    RowBox[{"MXdXdXd", " ", 
     SuperscriptBox["\[Epsilon]", "3"]}], "+", 
    RowBox[{"MXdXdXdXd", " ", 
     SuperscriptBox["\[Epsilon]", "4"]}], "+", 
    RowBox[{"MXdXdXdXdXd", " ", 
     SuperscriptBox["\[Epsilon]", "5"]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.989392619423821*^9, 3.989392744478835*^9}, {
  3.989426292429267*^9, 3.989426297956498*^9}, {3.998568192038287*^9, 
  3.9985681942934504`*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"59a04daa-636e-48fe-8268-97259e183ad4"],

Cell[CellGroupData[{

Cell["Finite difference derivatives", "Subsection",
 CellChangeTimes->{{3.9824049493608828`*^9, 
  3.982404966828836*^9}},ExpressionUUID->"611d7227-f612-47f8-bf8e-\
3ad25c7dcdbc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"k0", "=", 
   FractionBox["G", "2"]}], ";", 
  RowBox[{"\[CapitalDelta]k", "=", 
   SqrtBox["G"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"S", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{"\[CapitalSigma]", "[", 
    RowBox[{"k0", " ", "+", " ", 
     RowBox[{"j", " ", "\[CapitalDelta]k"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d0", "=", 
   RowBox[{"S", "[", "0", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d1", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", " ", "\[CapitalDelta]k"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"S", "[", "1", "]"}], "-", 
      RowBox[{"S", "[", 
       RowBox[{"-", "1"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d2", " ", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", " ", 
      SuperscriptBox["\[CapitalDelta]k", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"S", "[", "1", "]"}], "+", 
      RowBox[{"S", "[", 
       RowBox[{"-", "1"}], "]"}], "-", 
      RowBox[{"2", 
       RowBox[{"S", "[", "0", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"d2", " ", "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[CapitalDelta]k", "2"]}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"S", "[", "1", "]"}], "+", 
       RowBox[{"S", "[", 
        RowBox[{"-", "1"}], "]"}], "-", 
       RowBox[{"2", 
        RowBox[{"S", "[", "0", "]"}]}]}], ")"}]}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"d3", "=", 
   RowBox[{
    FractionBox[
     RowBox[{" ", "1"}], 
     RowBox[{"12", " ", 
      SuperscriptBox["\[CapitalDelta]k", "3"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"S", "[", "2", "]"}], "-", 
      RowBox[{"2", " ", 
       RowBox[{"S", "[", "1", "]"}]}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"S", "[", 
        RowBox[{"-", "1"}], "]"}]}], "-", 
      RowBox[{"S", "[", 
       RowBox[{"-", "2"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d4", "=", " ", 
   RowBox[{
    FractionBox[
     RowBox[{" ", "1"}], 
     RowBox[{"12", " ", 
      SuperscriptBox["\[CapitalDelta]k", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"S", "[", "2", "]"}], "-", 
      RowBox[{"4", " ", 
       RowBox[{"S", "[", "1", "]"}]}], "-", 
      RowBox[{"4", " ", 
       RowBox[{"S", "[", 
        RowBox[{"-", "1"}], "]"}]}], "+", 
      RowBox[{"S", "[", 
       RowBox[{"-", "2"}], "]"}], "+", 
      RowBox[{"6", " ", 
       RowBox[{"S", "[", "0", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d5", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"240", " ", 
      SuperscriptBox["\[CapitalDelta]k", "5"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"S", "[", "3", "]"}], "-", 
      RowBox[{"4", " ", 
       RowBox[{"S", "[", "2", "]"}]}], "+", 
      RowBox[{"5", " ", 
       RowBox[{"S", "[", "1", "]"}]}], "-", 
      RowBox[{"5", " ", 
       RowBox[{"S", "[", 
        RowBox[{"-", "1"}], "]"}]}], "+", 
      RowBox[{"4", " ", 
       RowBox[{"S", "[", 
        RowBox[{"-", "2"}], "]"}]}], "-", 
      RowBox[{"S", "[", 
       RowBox[{"-", "3"}], "]"}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.97992553800638*^9, 3.979925566713675*^9}, 
   3.9799265746758623`*^9, {3.982409520509491*^9, 3.9824095258594437`*^9}, 
   3.982410143249515*^9, {3.982411103264621*^9, 3.982411105200396*^9}, {
   3.982509389982739*^9, 3.982509392119747*^9}, 3.982510457967334*^9, 
   3.998565828323168*^9, {3.998565907350835*^9, 3.99856591049435*^9}, {
   3.998566595956778*^9, 3.998566597428093*^9}, 3.998566836203321*^9, 
