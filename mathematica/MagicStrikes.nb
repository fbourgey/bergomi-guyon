Cell[BoxData[
 RowBox[{
  RowBox[{"P5", "=", 
   RowBox[{"P4", "+", 
    RowBox[{
     RowBox[{"q", "[", "p", "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"5", 
          RowBox[{"W", "[", "p", "]"}]}], "2"], " ", "d4", " ", "d1"}], "+", 
       " ", 
       RowBox[{"5", 
        SuperscriptBox[
         RowBox[{"W", "[", "p", "]"}], "2"], " ", "d3", " ", "d2"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["21", "2"], "+", 
          RowBox[{
           FractionBox["9", "2"], 
           RowBox[{"\[Omega]", "[", "p", "]"}]}]}], ")"}], " ", 
        RowBox[{"W", "[", "p", "]"}], " ", "d3", " ", 
        SuperscriptBox["d1", "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"10", "+", 
          RowBox[{
           FractionBox["9", "2"], 
           RowBox[{"\[Omega]", "[", "p", "]"}]}]}], ")"}], 
        RowBox[{"W", "[", "p", "]"}], " ", 
        SuperscriptBox["d2", "2"], "d1"}], "+", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["9", "2"], "+", 
          RowBox[{
           FractionBox["1", "2"], 
           RowBox[{"W", "[", "p", "]"}]}], "+", 
          RowBox[{"12", 
           RowBox[{"\[Omega]", "[", "p", "]"}]}], " ", "+", 
          RowBox[{
           FractionBox["3", "2"], 
           SuperscriptBox[
            RowBox[{"\[Omega]", "[", "p", "]"}], "2"]}]}], ")"}], " ", "d2", " ", 
        SuperscriptBox["d1", "3"]}], "+", 
       RowBox[{
        FractionBox["1", "16"], 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"17", 
           RowBox[{"\[Lambda]", "[", "p", "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"14", 
              RowBox[{"\[Lambda]", "[", "p", "]"}]}]}], ")"}], 
