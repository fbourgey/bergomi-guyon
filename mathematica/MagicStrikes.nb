       SuperscriptBox["M", "2"]}], "+", 
      RowBox[{"16", " ", "k", " ", 
       SuperscriptBox["M", "2"]}], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["M", "3"]}]}], ")"}], " ", "MXdXd"}], 
   RowBox[{"16", " ", 
    SuperscriptBox["M", "3"]}]]}]], "Output",
